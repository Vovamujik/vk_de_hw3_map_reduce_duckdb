# Локальный учебный RustFS (docker compose). Скопируйте в .env и задайте свой секрет.
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=labadmin
S3_SECRET_KEY=change-me-long-random-secret
S3_REGION=us-east-1
S3_BUCKET=vacancies
RUSTFS_API_PORT=9100
RUSTFS_CONSOLE_PORT=9101
# Путь к исходному CSV на хосте (для загрузки в RustFS)
SOURCE_CSV=~/Downloads/it_vacancies_2024.csv
